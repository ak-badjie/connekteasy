rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Super admins are pinned to an email allowlist, mirrored in
    // app/lib/admin.ts and functions/src/staff.ts. Keeping it here as well
    // means the first super admin works before any document says so.
    function superAdminEmails() {
      return ['admin@connekt.gm'];
    }

    function isSuperAdminUser() {
      return isAuth() && (
        profile().get('isSuperAdmin', false) == true
        || (request.auth.token.email != null
            && request.auth.token.email.lower() in superAdminEmails())
      );
    }

    function isAdminUser() {
      return isAuth() && (profile().get('isAdmin', false) == true || isSuperAdminUser());
    }

    function hasRole(role) {
      return isAuth() && profile().role == role;
    }

    // Memberships are written only by the payment webhook (Admin SDK, which
    // bypasses these rules), so this is a trustworthy source of truth.
    function membershipActive() {
      return isAuth()
        && exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid))
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.status != 'expired'
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.currentPeriodEnd > request.time;
    }

    // Seekers pay 200 GMD/30d to apply. Employers pay 1000 GMD/30d to post.
    // Freelancers may also subscribe in order to apply, as they always could.
    function canApply() {
      return (hasRole('job_seeker') || hasRole('student') || hasRole('va'))
        && membershipActive();
    }

    function canPostJobs() {
      return hasRole('client') && membershipActive();
    }

    // ── Users ──────────────────────────────────────────
    function vaStatusOf(data) {
      return data.get('vaVerificationStatus', 'not_submitted');
    }

    // Freelancers may submit or re-submit accreditation documents, which can
    // only ever land them back in the review queue.
    function vaSelfSubmit() {
      return vaStatusOf(request.resource.data) == 'pending'
        && vaStatusOf(resource.data) in ['not_submitted', 'pending', 'rejected']
        && request.resource.data.get('vaVerificationNote', '') == ''
        && request.resource.data.get('vaVerificationReviewedBy', '')
             == resource.data.get('vaVerificationReviewedBy', '');
    }

    // Admin rights are a super-admin decision; every other writer must leave
    // both flags exactly as they found them.
    function staffFlagsUntouched() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false);
    }

    // Any other self-edit must leave the review verdict exactly as it was.
    function vaVerdictUntouched() {
      return vaStatusOf(request.resource.data) == vaStatusOf(resource.data)
        && request.resource.data.get('vaVerificationNote', '')
             == resource.data.get('vaVerificationNote', '')
        && request.resource.data.get('vaVerificationReviewedBy', '')
             == resource.data.get('vaVerificationReviewedBy', '');
    }

    match /users/{uid} {
      // Profiles back the public profile pages, so they stay world-readable.
      allow read: if true;
      // A fresh account can never start out admin or pre-approved.
      allow create: if isOwner(uid)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isSuperAdmin', false) == false
        && vaStatusOf(request.resource.data) in ['not_submitted', 'pending'];
      // Users may edit their own profile but never grant themselves admin, and
      // never approve their own VA accreditation. Admins review on their behalf,
      // but only a super admin may hand out admin rights.
      allow update: if isSuperAdminUser()
        || (isAdminUser() && staffFlagsUntouched())
        || (isOwner(uid)
            && staffFlagsUntouched()
            && (vaVerdictUntouched() || vaSelfSubmit()));
      allow delete: if isOwner(uid);
    }

    // ── Jobs, internships & opportunities ──────────────
    match /jobs/{jobId} {
      // Listings are public so the board is browsable and indexable.
      allow read: if true;
      allow create: if (canPostJobs() || isAdminUser())
        && request.resource.data.postedBy == request.auth.uid;
      allow update, delete: if isAuth()
        && (resource.data.postedBy == request.auth.uid || isAdminUser());
    }

    // ── Where an imported listing is applied to ────────────
    // This is the "subscribe to apply" rule with teeth: the apply link is a
    // separate document, so a signed-out visitor — or a signed-in member who
    // has not paid — cannot read it out of Firestore even with the SDK.
    // Written only by the daily sync (Admin SDK, which bypasses these rules).
    match /jobLinks/{jobId} {
      allow read: if canApply()
        || isAdminUser()
        || (isAuth()
            && get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy == request.auth.uid);
      allow write: if isAdminUser();
    }

    // ── Daily job sync bookkeeping ─────────────────────────
    match /jobSyncRuns/{runId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // ── Outbound notification log (functions only) ─────────
    match /notifications/{notificationId} {
      allow read: if isAdminUser()
        || (isAuth() && resource.data.get('uid', '') == request.auth.uid);
      allow write: if false;
    }

    // ── Job applications ───────────────────────────────
    match /jobApplications/{applicationId} {
      allow read: if isAuth() && (
        resource.data.applicantId == request.auth.uid
        || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid
        || isAdminUser()
      );
      // Applying is what the seeker membership buys.
      allow create: if canApply()
        && request.resource.data.applicantId == request.auth.uid;
      // Employers move applications through their pipeline.
      allow update: if isAuth() && (
        get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid
        || isAdminUser()
      );
      allow delete: if isAuth() && resource.data.applicantId == request.auth.uid;
    }

    // ── Memberships & payments (webhook-owned) ─────────
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdminUser();
      // Cancelling stops renewal; it must not extend or reactivate access.
      allow update: if isOwner(uid)
        && request.resource.data.status == 'cancelled'
        && request.resource.data.currentPeriodEnd == resource.data.currentPeriodEnd
        && request.resource.data.plan == resource.data.plan;
      allow create, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdminUser());
      allow write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdminUser());
      allow write: if false;
    }

    // ── Projects (freelance marketplace) ───────────────
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdminUser());
      allow delete: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdminUser());
    }

    // ── Proposals ──────────────────────────────────────
    match /proposals/{proposalId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.freelancerId == request.auth.uid;
      allow update: if isAuth();
    }

    // ── Admin-published content ────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // ── Employer hiring tools ──────────────────────────
    match /interviews/{interviewId} {
      allow read: if isAuth() && (
        resource.data.employerId == request.auth.uid
        || resource.data.candidateId == request.auth.uid
        || isAdminUser()
      );
      allow create: if canPostJobs()
        && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.employerId == request.auth.uid;
    }

    match /assessments/{assessmentId} {
      allow read: if isAuth();
      allow create: if canPostJobs()
        && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.employerId == request.auth.uid;
    }

    // ── Reviews ────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.reviewerId == request.auth.uid;
    }

    // ── Conversations & Messages ───────────────────────
    match /conversations/{convoId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
